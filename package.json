{
  "name": "ziban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "字伴：把查字典简化成一次停留——老人看得懂屏幕，孩子在探索里认字。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADES-RepkSSS/ziban.git"
  },
  "homepage": "https://ades-repksss.github.io/ziban/",
  "bugs": {
    "url": "https://github.com/ADES-RepkSSS/ziban/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm content:build && pnpm --filter @ziban/web dev",
    "build": "pnpm content:build && pnpm --filter @ziban/web build",
    "preview": "pnpm --filter @ziban/web preview",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "corpus:validate": "node scripts/validate-corpus.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "check:github": "node tools/check-github-files.cjs",
    "check": "pnpm content:validate && pnpm typecheck && pnpm test && pnpm build && pnpm check:github",
    "screenshot": "node scripts/screenshot.mjs",
    "desktop:build": "pnpm content:build && pnpm --filter @ziban/web build && node scripts/build-desktop.mjs && pnpm desktop:prepare",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:start": "node scripts/launch-electron.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:dev": "pnpm desktop:build && pnpm desktop:start",
    "desktop:ocr-smoke": "pnpm desktop:build && node scripts/launch-electron.mjs --ocr-smoke",
    "desktop:ui-smoke": "pnpm desktop:build && node scripts/launch-electron.mjs --ui-smoke",
    "desktop:lookup-smoke": "pnpm desktop:build && node scripts/launch-electron.mjs --lookup-smoke",
    "desktop:hover-smoke": "pnpm desktop:build && node scripts/launch-electron.mjs --hover-smoke"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "yaml": "^2.9.1",
    "zod": "4.1.12"
  }
}
